APP_HOST=127.0.0.1
APP_PORT=8001
DATABASE_URL=sqlite:///./data/my_threatlens.db

# Search and collection
SCAN_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=12
MAX_RESULTS_PER_SOURCE=200
RESULTS_PAGE_SIZE=50
MAX_UPLOAD_BYTES=5242880
LIVE_COLLECTORS_ENABLED=true

# Optional protection for an internet-hosted supervisor demo.
# Keep REQUIRE_DEMO_AUTH=false for normal local use.
REQUIRE_DEMO_AUTH=false
DEMO_USERNAME=
DEMO_PASSWORD=

# Gmail SMTP using SSL. Use the recipient's own Google app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Local Ollama chatbot
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
