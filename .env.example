APP_HOST=127.0.0.1
APP_PORT=8001
DATABASE_URL=sqlite:///./data/my_threatlens.db
PUBLIC_BASE_URL=http://127.0.0.1:8001

# Search and collection
SCAN_INTERVAL_SECONDS=1800
REQUEST_TIMEOUT_SECONDS=12
MAX_RESULTS_PER_SOURCE=200
RESULTS_PAGE_SIZE=50
MAX_UPLOAD_BYTES=5242880
LIVE_COLLECTORS_ENABLED=true

# Keep false for localhost. Set true only behind HTTPS.
SECURE_COOKIES=false

# Zoho Mail API (recommended for hosted deployments where SMTP is blocked).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_FROM_EMAIL=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_MAIL_BASE_URL=https://mail.zoho.com

# Automatic reports. Leave the recipient empty until you are ready to enable them.
AUTOMATIC_EMAIL_RECIPIENT=
AUTOMATIC_EMAIL_TIMEZONE=Asia/Beirut
AUTOMATIC_EMAIL_HOUR=9
AUTOMATIC_EMAIL_MINUTE=0
AUTOMATIC_EMAIL_SETUP_NAME=
CRITICAL_EMAIL_ENABLED=true

# Optional standard SMTP delivery. Leave blank when using Zoho API or no email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Local Ollama: use http://127.0.0.1:11434 and leave OLLAMA_API_KEY blank.
# Ollama Cloud/API: use https://ollama.com and add your own OLLAMA_API_KEY.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=120
