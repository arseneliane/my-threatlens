APP_HOST=127.0.0.1
APP_PORT=8001
DATABASE_URL=sqlite:///./data/my_threatlens.db

# Search and collection
SCAN_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=12
MAX_RESULTS_PER_SOURCE=200
RESULTS_PAGE_SIZE=50
MAX_UPLOAD_BYTES=5242880
LIVE_COLLECTORS_ENABLED=true

# Optional protection for an internet-hosted supervisor demo.
# Keep REQUIRE_DEMO_AUTH=false for normal local use.
REQUIRE_DEMO_AUTH=false
DEMO_USERNAME=
DEMO_PASSWORD=

# Zoho Mail API (recommended for hosted deployments where SMTP is blocked).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_FROM_EMAIL=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_MAIL_BASE_URL=https://mail.zoho.com

# Optional SMTP fallback for local or paid deployments.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# AI assistants through Ollama. For the hosted site, use
# OLLAMA_URL=https://ollama.com and keep the API key only in Render.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=120
