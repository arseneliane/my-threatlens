APP_HOST=127.0.0.1
APP_PORT=8001
DATABASE_URL=sqlite:///./data/my_threatlens.db
PUBLIC_BASE_URL=https://my-threatlens-demo.onrender.com

# Search and collection
SCAN_INTERVAL_SECONDS=1800
REQUEST_TIMEOUT_SECONDS=12
MAX_RESULTS_PER_SOURCE=200
RESULTS_PAGE_SIZE=50
MAX_UPLOAD_BYTES=5242880
LIVE_COLLECTORS_ENABLED=true

# Optional protection for an internet-hosted supervisor demo.
# Account login is always enabled. Set this to true when the site uses HTTPS.
SECURE_COOKIES=false
SHARED_USERNAME=cyber expert
SHARED_PASSWORD=

# Zoho Mail API (recommended for hosted deployments where SMTP is blocked).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_FROM_EMAIL=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_MAIL_BASE_URL=https://mail.zoho.com

# Automatic reports. Leave the recipient empty until you are ready to enable them.
AUTOMATIC_EMAIL_RECIPIENT=
AUTOMATIC_EMAIL_TIMEZONE=Asia/Beirut
AUTOMATIC_EMAIL_HOUR=9
AUTOMATIC_EMAIL_MINUTE=0
AUTOMATIC_EMAIL_SETUP_NAME=
CRITICAL_EMAIL_ENABLED=true

# Optional SMTP fallback for local or paid deployments.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# AI assistants through Ollama. For the hosted site, use
# OLLAMA_URL=https://ollama.com and keep the API key only in Render.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=120
